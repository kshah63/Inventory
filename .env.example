# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, never exposed to the browser.
# Needed for the admin "Users" screen (creating logins) and the cron digest.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────────────────
# Public URL of the deployed app (used in WhatsApp alert links)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Secret used to protect the Vercel cron endpoint. Generate with:
#   openssl rand -hex 32
CRON_SECRET=change-me

# ── Twilio WhatsApp (optional — alerts are skipped gracefully if unset) ───
# Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Your approved WhatsApp sender number (or the sandbox number while testing):
TWILIO_WHATSAPP_FROM=whatsapp:+6591234567

# Approved content template SIDs (HX…), one per message kind — REQUIRED for a
# production WhatsApp sender: business-initiated messages outside a 24h reply
# window are only delivered as approved templates. Exact template bodies to
# register are in docs/DEPLOYMENT.md §3. Leave unset for sandbox testing
# (freeform messages are used instead).
TWILIO_CONTENT_SID_DIGEST=
TWILIO_CONTENT_SID_OUT_OF_STOCK=
TWILIO_CONTENT_SID_APPROVAL_NEEDED=
TWILIO_CONTENT_SID_APPROVAL_DECIDED=
TWILIO_CONTENT_SID_REQUEST_UPDATE=
