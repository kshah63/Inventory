# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, never exposed to the browser.
# Needed for the admin "Users" screen (creating logins) and the cron digest.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────────────────
# Public URL of the deployed app (used in WhatsApp alert links)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Secret used to protect the Vercel cron endpoint. Generate with:
#   openssl rand -hex 32
CRON_SECRET=change-me

# ── Twilio WhatsApp (optional — alerts are skipped gracefully if unset) ───
# Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Your Twilio WhatsApp sender, e.g. the sandbox number while testing:
#   whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
